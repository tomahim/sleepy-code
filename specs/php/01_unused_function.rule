### Description
This rule checks for unused functions in the php files bellow.

### Depends on collectors
specs/php/collectors/function.collector


### file:File1.php

class File1 {
    public function publicUnusedFunction() {
    }

    private function privateUnusedFunction() {
    }

    public function functionUsingFile2ButNotUsedItself() {
        $file2 = new File2();
        $file2->usedFunction();
    }
}

### file:File2.php

class File2 {
    public function usedFunction() {}

    public function unusedFunctionFile2() {}
}

### JSON output
[
    {
        "line": 3,
        "name": "publicUnusedFunction",
        "message": "Unused function File1::publicUnusedFunction",
        "rule": "unused-function",
        "file": "File1.php"
    }, {
        "line": 4,
        "name": "privateUnusedFunction",
        "message": "Unused function File1::privateUnusedFunction",
        "rule": "unused-function",
        "file": "File1.php"
    }, {
        "line": 8,
        "name": "functionUsingFile2ButNotUsedItself",
        "message": "Unused function File1::functionUsingFile2ButNotUsedItself",
        "rule": "unused-function",
        "file": "File1.php"
    }, {
        "line": 5,
        "name": "unusedFunctionFile2",
        "message": "Unused function File2::unusedFunctionFile2",
        "rule": "unused-function",
        "file": "File2.php"
    }
]
